  "programs": {
    "000068": {
      "coverage": [
        {
          "quote": "real-time update function",
          "scope": "local",
          "reason": "Simulated real-time update by toggling a local boolean flag that changes the displayed status.",
          "control": "Toggle Real-Time Update"
        },
        {
          "quote": "displaying the air quality index (AQI) for the past two weeks",
          "scope": "read",
          "reason": "This requires historical data from an external service; no local state can generate two weeks of AQI values."
        },
        {
          "quote": "allowing users to compare pollution and air quality changes",
          "scope": "read",
          "reason": "Comparison requires external data or preloaded sample data; no local state can create meaningful comparison."
        },
        {
          "quote": "browse current weather and air quality data",
          "scope": "read",
          "reason": "Current data requires external sensor input; no local state can provide real sensor readings."
        },
        {
          "quote": "Set primary background to azure mist and elements to dark slate blue",
          "scope": "local",
          "reason": "Color theme can be toggled via a local boolean that switches between default and specified colors.",
          "control": "Apply Azure Mist Theme"
        }
      ],
