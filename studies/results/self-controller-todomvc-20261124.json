        "menu": [
          {
            "id": "add",
            "behavior": "Creates a new todo with a unique ID, trimmed title, and completed false if the input is not empty; otherwise destroys the current editing state.",
            "default": true
          },
          {
            "id": "toggle",
            "behavior": "Toggles the completed status of a specific todo by its ID.",
            "default": true
          },
          {
            "id": "edit",
            "behavior": "Activates editing mode for a specific todo by double-clicking or dispatching an edit event; saves on blur/Enter if non-empty, destroys if empty, cancels on Escape.",
            "default": true
          },
          {
            "id": "clearCompleted",
            "behavior": "Removes all todos where the completed status is true from the list.",
            "default": true
          },
          {
            "id": "route",
            "behavior": "Filters the visible todo list based on the active route (all, active, completed) and updates the model accordingly when the route changes.",
            "default": true
          }
